# Derived from examples/lambda_calculus/arithmetic.treetop with the embedded
# Ruby actions ({ ... } inline modules) removed, so the eval-free bytecode
# backend can compile it. Structure, labels and node class declarations are
# unchanged.
grammar Arithmetic
  rule expression
    comparative / additive
  end

  rule comparative
    head:additive
    tail:(
      space operator:equality_op
      space operand:additive)* <BinaryOperation>
  end

  rule equality_op
    '==' / '!='
  end

  rule additive
    head:multitive
    tail:(
      space operator:additive_op
      space operand:multitive)* <BinaryOperation>
  end

  rule additive_op
    '+' / '-'
  end

  rule multitive
    head:primary
    tail:(
      space operator:multitive_op
      space operand:primary)* <BinaryOperation>
  end

  rule multitive_op
    '*' / '/'
  end

  rule primary
    variable
    /
    number
    /
    '(' space expression space ')'
  end

  rule variable
    [a-z]+
  end

  rule number
    ([1-9] [0-9]* / '0')
  end

  rule space
    ' '*
  end
end

